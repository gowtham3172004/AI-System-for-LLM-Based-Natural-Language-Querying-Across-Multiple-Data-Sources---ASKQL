# ===================== AskQL configuration =====================
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
# On hosted platforms set these as environment variables / secrets instead of using a file.

# ---- LLM providers --------------------------------------------------------
# Providers are tried in this order. Keys WITHIN a provider are rotated round-robin; any failure
# (rate limit, quota, bad key, outage) falls through to the next key, then the next provider.
LLM_PROVIDER_ORDER=groq,gemini,ollama

# Groq (free tier: https://console.groq.com/keys) - comma-separated, as many as you like
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier: https://aistudio.google.com/apikey) - comma-separated
GEMINI_API_KEYS=
# Google retires model names over time (gemini-2.0-flash is gone). The *-latest alias keeps working;
# pin a specific model here if you prefer.
GEMINI_MODEL=gemini-flash-latest

# Ollama (local / self-hosted). Empty = disabled.
# From Docker on Windows/Mac use http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Max keys tried per provider for one request (bounds worst-case latency when many keys are set)
LLM_TRIES_PER_PROVIDER=2

# ---- Safety & limits ------------------------------------------------------
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
MAX_REPAIR_ATTEMPTS=2
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=10
MAX_ROWS_PER_FILE=1000000
DUCKDB_MEMORY_LIMIT=512MB

# SECURE DEFAULT = false. Blocks SQLite files, URL-parameter tricks, and any database host that resolves to a
# private/loopback/link-local address (SSRF). Set to true ONLY on your own machine to use localhost databases.
ALLOW_LOCAL_DATABASES=false

# false = never send sample values or result rows to the LLM provider (only schema + SQL).
LLM_SEND_DATA=true

# ---- Abuse protection (protects your free-tier LLM quota) -----------------
RATE_LIMIT_PER_MINUTE=15
IP_RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=90

# ---- App ------------------------------------------------------------------
# If set, every REST API call (except /health) must send `X-API-Key: <value>`.
ASKQL_API_KEY=
# Query history. Use a free Postgres (Neon/Supabase) to survive redeploys on ephemeral hosts.
HISTORY_DB_URL=sqlite:///askql_history.db
# Comma-separated allowed browser origins for the REST API, e.g. https://you.github.io
CORS_ORIGINS=*
LOG_LEVEL=INFO
